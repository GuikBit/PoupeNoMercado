{
  "expo": {
    "name": "Poupe no Mercado",
    "slug": "poupe-no-mercado",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "poupenomercado",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.poupenomercado.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poupenomercado.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "O Poupe no Mercado usa a câmera para ler etiquetas de preço."
        }
      ]
    ]
  }
}
